APP_NAME=rustyroboz-api
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SQLITE_PATH=./data/site.db
FAISS_INDEX_PATH=./data/faiss.index
FAISS_META_PATH=./data/index_meta.json
CORS_ORIGINS=http://localhost:3000,http://web:3000
CONTENT_ROOT=./content

# Embeddings backend:
#   api       — remote OpenAI-compatible /embeddings (OpenRouter by default;
#               reuses OPENROUTER_API_KEY). ~0 extra RAM: use this on servers.
#   fastembed — local multilingual ONNX model (no network, ~700MB resident).
#   hash      — dependency-free lexical fallback (tests/offline).
EMBEDDINGS_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_DIMENSION=384
# Only for EMBEDDINGS_BACKEND=api (base URL / key fall back to the OpenRouter ones):
EMBEDDINGS_API_MODEL=openai/text-embedding-3-small
EMBEDDINGS_API_BASE_URL=
EMBEDDINGS_API_KEY=

# LLM provider — any OpenAI-compatible endpoint works (OpenRouter by default).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it:free
# Comma-separated list, tried in order when the primary model fails.
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=rustyroboz
LLM_TIMEOUT_SECONDS=60

# Agent + guardrails
GUARDRAILS_ENABLED=true
# Optional cheap/fast model for the guard classifier (empty = main model chain)
GUARD_MODEL=
AGENT_MAX_TOOL_ROUNDS=4
CHAT_HISTORY_LIMIT=12

# Abuse limits for the public endpoint
MAX_MESSAGE_CHARS=2000
MAX_ANSWER_CHARS=8000
RATE_LIMIT_PER_MINUTE=8
ANSWER_CACHE_TTL_SECONDS=3600

# Optional observability: full LangGraph traces in LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rustyroboz-chat
